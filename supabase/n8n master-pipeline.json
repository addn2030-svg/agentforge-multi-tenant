{
  "name": "AgentForge - Master Multi-Tenant Pipeline",
  "nodes": [
    {
      "parameters": {
        "path": "agent-execute",
        "responseMode": "onReceived"
      },
      "id": "webhook-receiver",
      "name": "Webhook Receiver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM get_current_branch_context()",
        "options": {}
      },
      "id": "context-injector",
      "name": "Context Injector (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.role }}",
              "operation": "notEmpty"
            }
          ]
        }
      },
      "id": "quota-gate",
      "name": "Quota & Permission Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 4096,\n  \"system\": \"You are an automation executor for branch {{ $json.branch_id }}. Use only the tools provided. If output fails schema, route to critic.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.payload) }}\n    }\n  ]\n}"
      },
      "id": "agent-executor",
      "name": "Agent Skill Executor (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.error }}",
              "operation": "exists"
            }
          ]
        }
      },
      "id": "schema-validator",
      "name": "Schema Validator & Critic Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-haiku-20240307\",\n  \"max_tokens\": 2048,\n  \"system\": \"You are the Critic Agent. Fix the JSON validation error. Output only the corrected JSON. If impossible, return {\\\"fix_status\\\": \\\"impossible\\\"}.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Original Request: {{ $json.original_payload }}\\nFailed Output: {{ $json.failed_output }}\\nError: {{ $json.validation_error }}\"\n    }\n  ]\n}"
      },
      "id": "critic-self-fix",
      "name": "Layer 1: Critic Self-Fix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 100]
    },
    {
      "parameters": {
        "operation": "push",
        "list": "dead_letter_queue:{{ $json.branch_id }}",
        "messageData": "={{ $json }}"
      },
      "id": "circuit-breaker",
      "name": "Layer 2: Circuit Breaker (Redis)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1450, 300],
      "credentials": {
        "redis": {
          "id": "YOUR_REDIS_CREDENTIAL_ID",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "🚨 *CRITICAL ALERT*\\nAgent execution failed after retries.\\n\\nBranch: `{{ $json.branch_id }}`\\nError: {{ $json.error_log }}\\n\\nPlease review and resume.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "human-escalation",
      "name": "Layer 3: Human Escalation (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1700, 300],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "tableId": "audit_logs",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "org_id",
              "fieldValue": "={{ $json.org_id }}"
            },
            {
              "fieldId": "branch_id",
              "fieldValue": "={{ $json.branch_id }}"
            },
            {
              "fieldId": "action",
              "fieldValue": "agent_execution"
            },
            {
              "fieldId": "details",
              "fieldValue": "={{ $json }}"
            },
            {
              "fieldId": "token_cost",
              "fieldValue": "={{ $json.usage?.total_tokens || 0 }}"
            }
          ]
        }
      },
      "id": "audit-logger",
      "name": "Audit Logger (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1700, 100],
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      }
    }
  ],
  "connections": {
    "Webhook Receiver": {
      "main": [[{ "node": "Context Injector (Supabase)", "type": "main", "index": 0 }]]
    },
    "Context Injector (Supabase)": {
      "main": [[{ "node": "Quota & Permission Gate", "type": "main", "index": 0 }]]
    },
    "Quota & Permission Gate": {
      "main": [
        [{ "node": "Agent Skill Executor (Claude)", "type": "main", "index": 0 }],
        [{ "node": "Layer 3: Human Escalation (Telegram)", "type": "main", "index": 0 }]
      ]
    },
    "Agent Skill Executor (Claude)": {
      "main": [[{ "node": "Schema Validator & Critic Router", "type": "main", "index": 0 }]]
    },
    "Schema Validator & Critic Router": {
      "main": [
        [{ "node": "Layer 1: Critic Self-Fix", "type": "main", "index": 0 }],
        [{ "node": "Audit Logger (Supabase)", "type": "main", "index": 0 }]
      ]
    },
    "Layer 1: Critic Self-Fix": {
      "main": [[{ "node": "Schema Validator & Critic Router", "type": "main", "index": 0 }]]
    },
    "Layer 2: Circuit Breaker (Redis)": {
      "main": [[{ "node": "Layer 3: Human Escalation (Telegram)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
