{
  "name": "AgentForge - Master Multi-Tenant Pipeline (Improved)",
  "nodes": [
    {
      "parameters": {
        "path": "agent-execute",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-receiver",
      "name": "Webhook Receiver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "agent-execute"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM get_current_branch_context()",
        "options": {}
      },
      "id": "context-injector",
      "name": "Context Injector (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.role }}",
              "operation": "notEmpty"
            }
          ]
        }
      },
      "id": "permission-gate",
      "name": "Permission Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "retry-count",
              "name": "retry_count",
              "value": "={{ $json.retry_count || 0 }}",
              "type": "number"
            },
            {
              "id": "branch-id",
              "name": "branch_id",
              "value": "={{ $json.branch_id }}",
              "type": "string"
            },
            {
              "id": "org-id",
              "name": "org_id",
              "value": "={{ $json.org_id }}",
              "type": "string"
            },
            {
              "id": "payload",
              "name": "payload",
              "value": "={{ $json.payload || $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "set-context",
      "name": "Set Context + Retry Counter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [940, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 4096,\n  \"system\": \"You are an automation executor for branch {{ $json.branch_id }}. Always return valid JSON. If you cannot complete the task, return {\\\"error\\\": \\\"description\\\"}.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.payload) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "agent-executor",
      "name": "Agent Skill Executor (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.content?.[0]?.text || $json.error }}",
              "operation": "contains",
              "value2": "error"
            }
          ]
        }
      },
      "id": "success-check",
      "name": "Success / Error Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1420, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.retry_count }}",
              "operation": "lt",
              "value2": 3
            }
          ]
        }
      },
      "id": "retry-check",
      "name": "Retry Check (Max 3)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1660, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "increment-retry",
              "name": "retry_count",
              "value": "={{ $json.retry_count + 1 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "increment-retry",
      "name": "Increment Retry Counter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1900, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-haiku-20240307\",\n  \"max_tokens\": 2048,\n  \"system\": \"You are the Critic Agent. Fix the previous output. Return only valid JSON. If impossible, return {\\\"fix_status\\\": \\\"impossible\\\"}.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Original payload: {{ JSON.stringify($json.payload) }}\\nFailed output: {{ $json.content?.[0]?.text || $json.error }}\\nPlease fix it.\"\n    }\n  ]\n}"
      },
      "id": "critic-agent",
      "name": "Layer 1: Critic Self-Fix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2140, 220]
    },
    {
      "parameters": {
        "operation": "push",
        "list": "=dead_letter_queue:{{ $json.branch_id }}",
        "messageData": "={{ $json }}"
      },
      "id": "circuit-breaker",
      "name": "Layer 2: Circuit Breaker (Redis)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1900, 480]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=🚨 *CRITICAL ALERT*\\n\\nAgent failed after 3 retries.\\n\\n*Branch:* `{{ $json.branch_id }}`\\n*Org:* `{{ $json.org_id }}`\\n\\nPlease review.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-escalation",
      "name": "Layer 3: Human Escalation (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2140, 480]
    },
    {
      "parameters": {
        "tableId": "audit_logs",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "org_id",
              "fieldValue": "={{ $json.org_id }}"
            },
            {
              "fieldId": "branch_id",
              "fieldValue": "={{ $json.branch_id }}"
            },
            {
              "fieldId": "action",
              "fieldValue": "agent_execution"
            },
            {
              "fieldId": "details",
              "fieldValue": "={{ $json }}"
            }
          ]
        }
      },
      "id": "audit-logger",
      "name": "Audit Logger",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1660, 80]
    }
  ],
  "connections": {
    "Webhook Receiver": {
      "main": [[{ "node": "Context Injector (Supabase)", "type": "main", "index": 0 }]]
    },
    "Context Injector (Supabase)": {
      "main": [[{ "node": "Permission Gate", "type": "main", "index": 0 }]]
    },
    "Permission Gate": {
      "main": [
        [{ "node": "Set Context + Retry Counter", "type": "main", "index": 0 }],
        [{ "node": "Layer 3: Human Escalation (Telegram)", "type": "main", "index": 0 }]
      ]
    },
    "Set Context + Retry Counter": {
      "main": [[{ "node": "Agent Skill Executor (Claude)", "type": "main", "index": 0 }]]
    },
    "Agent Skill Executor (Claude)": {
      "main": [[{ "node": "Success / Error Check", "type": "main", "index": 0 }]]
    },
    "Success / Error Check": {
      "main": [
        [{ "node": "Retry Check (Max 3)", "type": "main", "index": 0 }],
        [{ "node": "Audit Logger", "type": "main", "index": 0 }]
      ]
    },
    "Retry Check (Max 3)": {
      "main": [
        [{ "node": "Increment Retry Counter", "type": "main", "index": 0 }],
        [{ "node": "Layer 2: Circuit Breaker (Redis)", "type": "main", "index": 0 }]
      ]
    },
    "Increment Retry Counter": {
      "main": [[{ "node": "Layer 1: Critic Self-Fix", "type": "main", "index": 0 }]]
    },
    "Layer 1: Critic Self-Fix": {
      "main": [[{ "node": "Success / Error Check", "type": "main", "index": 0 }]]
    },
    "Layer 2: Circuit Breaker (Redis)": {
      "main": [[{ "node": "Layer 3: Human Escalation (Telegram)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
